{
  "schemaVersion": 1,
  "id": "parcool",
  "version": "${version}",
  "name": "ParCool!",
  "description": "Unofficial Fabric port of ParCool! by alRex_U for Minecraft 26.3. Parkour moves: ledge grab, wall run, wall jump, crawl, vault, roll and more.",
  "authors": [
    "alRex_U (original)",
    "sanufsoii (Architectury port)",
    "sotadevop (26.3 port)"
  ],
  "contact": {
    "homepage": "https://github.com/sotadevop/parcool-unofficial",
    "sources": "https://github.com/sotadevop/parcool-unofficial",
    "issues": "https://github.com/sotadevop/parcool-unofficial/issues"
  },
  "license": "LGPL-3.0",
  "icon": "parcool_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.alrex.parcool.ParCoolFabric"
    ],
    "client": [
      "com.alrex.parcool.ParCoolFabricClient"
    ],
    "modmenu": [
      "com.alrex.parcool.ParCoolModMenu"
    ]
  },
  "mixins": [
    "parcool-common.mixins.json"
  ],
  "accessWidener": "parcool.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25",
    "architectury": ">=22.0.0"
  },
  "custom": {
    "mixinextras": {
      "required": false
    }
  },
  "suggests": {
    "patchouli": "*",
    "shouldersurfing": "*",
    "modmenu": "*"
  }
}
